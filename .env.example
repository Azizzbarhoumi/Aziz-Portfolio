NEXT_PUBLIC_SITE_URL=https://your-domain.example
QWEN_API_KEY=your-qwen-api-key
GEMINI_API_KEY=your-gemini-api-key
# Optional; defaults to Qwen 3.8 Flash and the international Model Studio endpoint.
# QWEN_MODEL=qwen3.8-flash
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Gemini is used only for embeddings and search; Qwen remains the chat answer model.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
# Optional; used when EMBEDDING_PROVIDER=qwen and EMBEDDING_MODEL is unset.
# QWEN_EMBEDDING_MODEL=text-embedding-v3
